<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- the apps update themselves from the TV (AppUpdater); Android asks on the screen each time -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- the phone page's server on the home network (ControlService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- the game-time countdown over any input (granted once, from the setup) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- the morning alarm: wake the TV at its time -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- the launcher (same signing key) reads the settings for its home-screen card -->
    <permission
        android:name="sa.yourtv.v2.screensaver.READ_CONFIG"
        android:protectionLevel="signature" />

    <!-- opens the launcher's «ترتيب المفضلة» from settings -->
    <queries>
        <package android:name="sa.yourtv.v2.home" />
        <!-- turns Tailscale back on when Android stopped it, for the phone page from outside home -->
        <package android:name="com.tailscale.ipn" />
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner_v2"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- opening the app shows its settings -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- full-screen preview; any remote key closes it -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <service
            android:name=".ScreenDream"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>

        <service
            android:name=".ControlService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A web page on the home network for setting this TV's screensaver from a phone" />
        </service>

        <service
            android:name=".UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- settings from ADB (agents, optimize/saver.sh); DUMP = only the shell can send it -->
        <receiver
            android:name=".SaverReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="sa.yourtv.v2.screensaver.GET" />
                <action android:name="sa.yourtv.v2.screensaver.SET" />
                <action android:name="sa.yourtv.v2.screensaver.CITIES" />
                <action android:name="sa.yourtv.v2.screensaver.UPDATE" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".ConfigProvider"
            android:authorities="sa.yourtv.v2.screensaver.config"
            android:exported="true"
            android:readPermission="sa.yourtv.v2.screensaver.READ_CONFIG" />
        <receiver android:name=".MorningAlarm" android:exported="false" />
        <receiver android:name=".AppUpdater$Done" android:exported="false" />
    </application>
</manifest>
