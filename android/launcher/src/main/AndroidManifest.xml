<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen adapted from github.com/mihirgupta0900/tv-home (MIT). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />   <!-- hosted wallpapers, the optional card -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 11 only reveals the Wi-Fi name to apps holding location; granted over ADB at install. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- the optional home-screen card reads the screensaver's settings (signature permission, same key) -->
    <uses-permission android:name="sa.yourtv.v2.screensaver.READ_CONFIG" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <package android:name="com.tcl.tv" />
        <package android:name="com.tcl.suspension" />
        <package android:name="sa.yourtv.v2.screensaver" />
    </queries>

    <application
        android:label="YourTV V2"
        android:icon="@drawable/ic_v2"
        android:banner="@drawable/banner_v2"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Home">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- «ترتيب المفضلة»: the favourites as a list; also opened from the screensaver's settings -->
        <activity
            android:name=".DockActivity"
            android:exported="true"
            android:label="ترتيب المفضلة"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- favourites row from ADB (agents, optimize/dock.sh); DUMP = only the shell can send it -->
        <receiver
            android:name=".DockReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="sa.yourtv.v2.home.GET_DOCK" />
                <action android:name="sa.yourtv.v2.home.LIST_APPS" />
                <action android:name="sa.yourtv.v2.home.SET_DOCK" />
                <action android:name="sa.yourtv.v2.home.RESET_DOCK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
